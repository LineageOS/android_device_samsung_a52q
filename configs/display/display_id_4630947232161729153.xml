    <screenBrightnessDefault>0.48235294</screenBrightnessDefault>

    <highBrightnessMode enabled="true">
        <transitionPoint>0.5247</transitionPoint>
        <minimumHdrPercentOfScreen>0.1</minimumHdrPercentOfScreen>
        <minimumLux>3000</minimumLux>
        <timing>
            <timeWindowSecs>1800</timeWindowSecs>
            <timeMaxSecs>300</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>8.0</hdrRatio>
            </point>
            <point>
                <sdrNits>800.0</sdrNits>
                <hdrRatio>2.0</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>

    <autoBrightness enabled="true">
        <brighteningLightDebounceMillis>1500</brighteningLightDebounceMillis>
        <darkeningLightDebounceMillis>1500</darkeningLightDebounceMillis>
    </autoBrightness>

    <hdrBrightnessConfig>
        <brightnessMap>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>0</brightnessIncreaseDebounceMillis>
        <screenBrightnessRampIncrease>-1.0</screenBrightnessRampIncrease>
        <brightnessDecreaseDebounceMillis>0</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampDecrease>-1.0</screenBrightnessRampDecrease>
    </hdrBrightnessConfig>

    <lightSensor>
        <type>com.samsung.sensor.auto_brightness</type>
        <name>stk_stk31610 Auto Brightness Non-wakeup</name>
    </lightSensor>
